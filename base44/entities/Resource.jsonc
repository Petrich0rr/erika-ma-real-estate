{
  "name": "Resource",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Buyer Guide",
        "Seller Guide",
        "Mortgage",
        "Land Transfer Tax",
        "Closing Costs",
        "Market Updates",
        "Articles",
        "Neighbourhood Guides"
      ]
    },
    "summary": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "resource_type": {
      "type": "string",
      "enum": [
        "Guide",
        "Calculator",
        "Article",
        "Video",
        "Download"
      ],
      "default": "Article"
    },
    "downloadable": {
      "type": "boolean",
      "default": false
    },
    "file_url": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "category"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}