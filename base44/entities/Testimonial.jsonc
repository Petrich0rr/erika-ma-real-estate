{
  "name": "Testimonial",
  "type": "object",
  "properties": {
    "client_name": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "quote": {
      "type": "string"
    },
    "rating": {
      "type": "number"
    },
    "photo": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "client_name",
    "quote"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}